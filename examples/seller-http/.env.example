# The Stellar address that receives payment.
SELLER_ADDRESS=

FACILITATOR_URL=http://localhost:4021

# SEP-41 token to price routes in. Defaults to testnet USDC if unset — set
# this to your own test token if the buyer doesn't hold testnet USDC (see
# e2e/conformance/README.md for how to mint a throwaway one).
ASSET_TOKEN=

PORT=4022
