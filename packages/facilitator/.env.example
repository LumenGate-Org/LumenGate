# Stellar secret key(s) for the facilitator's signer(s). Comma-separated for
# multiple (round-robin), or use STELLAR_FACILITATOR_SECRET for just one.
STELLAR_FACILITATOR_SECRETS=

# Which `upto`/`managed upto` contract design is active: "escrow" (default —
# x402UptoStellarEscrowSettlement, no approve() prerequisite, no persistent
# on-chain state) or "allowance" (x402UptoStellarSettlement, offers
# cancel()/is_settled() at the cost of persistent state). See "The `upto`
# settlement design" in docs/architecture.md.
UPTO_DESIGN=escrow

# Deployed x402UptoStellarEscrowSettlement contract address per network —
# used when UPTO_DESIGN=escrow (the default). Required to enable the `upto`
# scheme (exact works without it).
UPTO_ESCROW_SETTLEMENT_CONTRACT_TESTNET=
UPTO_ESCROW_SETTLEMENT_CONTRACT_PUBNET=

# Deployed x402UptoStellarSettlement (allowance-based) contract address per
# network — used only when UPTO_DESIGN=allowance.
UPTO_SETTLEMENT_CONTRACT_TESTNET=
UPTO_SETTLEMENT_CONTRACT_PUBNET=

# Optional pool of dedicated channel accounts for upto/managed-upto
# settlement submission (comma-separated secret keys) — decouples
# transaction-level sequence-number/fee handling from the facilitator
# signer identity under concurrent load. Not required; exact and upto both
# work without it (falls back to the facilitator signer paying fees
# directly). See "Channel accounts" in docs/runbook.md. Fund with XLM only
# — no trustline, no other balance needed.
STELLAR_CHANNEL_ACCOUNT_SECRETS=

# Stellar mainnet Soroban RPC endpoint. Required to enable stellar:pubnet at
# all (both `exact` and `upto`) — unlike testnet, mainnet has no free public
# default. See https://developers.stellar.org/docs/data/apis/rpc/providers
# for provider options; https://mainnet.sorobanrpc.com is a public one with
# no signup, fine for low-volume/prototype use, verified reachable in this
# project's own conformance checks (read-only calls only — see
# e2e/conformance/README.md). Leave unset to run testnet-only.
STELLAR_PUBNET_RPC_URL=

PORT=4021
DISCOVERY_DB_PATH=./data/discovery.db
BILLING_DB_PATH=./data/billing.db

# If set, GET /billing/usage requires this exact value in an
# X-Billing-Admin-Token header. Unset (default) leaves it open, matching this
# prototype's zero-config demo posture — set it before exposing usage/volume data
# for a real deployment.
BILLING_ADMIN_TOKEN=
