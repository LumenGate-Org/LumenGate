FACILITATOR_URL=http://localhost:4021

# Only required for the call_resource tool (search_resources/list_resources
# work without it). The Stellar secret key the agent pays from.
AGENT_SECRET=

# Optional spending guardrails for call_resource, since it moves real funds
# from AGENT_SECRET autonomously. Both unset by default (unrestricted, for
# the local demo flow) — set them before pointing this server at an agent
# with real funds.
AGENT_ALLOWED_HOSTS=
AGENT_MAX_PAYMENT_AMOUNT=
